
---
const business = {
  name: 'CENTER INN (仮)',
  operator: '宿泊施設運営責任者 (仮)',
  address: '〒000-0000 仮住所 (デバッグ用)',
  phone: '000-0000-0000',
  email: 'example@example.com',
  license: '旅館業許可番号：仮番号 (未確定)',
  price: '宿泊日・人数・プランにより予約画面に表示',
