---
// src/pages/admin/scanner.astro
---
<script>
      let html5QrCode = null;

      async function onScanSuccess(decodedText, decodedResult) {
        console.log(`Code matched = ${decodedText}`, decodedResult);
        
        // スキャナーが動いている場合は安全に停止する
        if (html5QrCode && html5QrCode.isScanning) {
          try {
            await html5QrCode.stop();
          } catch (err) {
            console.error("Failed to stop scanner.", err);
          }
        }

        processCheckIn(decodedText);
      }

      async function processCheckIn(reservationCode) {
        const resultContainer = document.getElementById('result-container');
        const resultTitle = document.getElementById('result-title');
        const resultDetails = document.getElementById('result-details');
        const restartBtn = document.getElementById('restart-btn');

        resultContainer.style.display = 'block';
        resultContainer.style.background = '#fef3c7';
        resultTitle.style.color = '#92400e';
        resultTitle.innerText = '処理中...';
        resultDetails.innerText = `予約コード: ${reservationCode} の確認を行っています`;

        try {
          const res = await fetch('/api/admin/check-in', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reservationCode })
          });

          const data = await res.json();

          if (res.ok) {
            resultContainer.style.background = '#dcfce7';
            resultTitle.style.color = '#166534';
            resultTitle.innerText = data.alreadyCheckedIn ? '⚠️ すでにチェックイン済みです' : '✅ チェックインが完了しました！';
            
            const r = data.reservation;
            resultDetails.innerHTML = `
              <strong>予約コード:</strong> ${r.reservation_code || reservationCode}<br>
              <strong>お名前:</strong> ${r.guest_name} 様<br>
              <strong>宿泊日程:</strong> ${r.check_in_date} 〜 ${r.check_out_date}<br>
              <strong>人数:</strong> ${r.guests_count || 1}名
            `;
          } else {
            resultContainer.style.background = '#fee2e2';
            resultTitle.style.color = '#991b1b';
            resultTitle.innerText = '❌ エラーが発生しました';
            resultDetails.innerText = data.error || '無効なQRコードです。';
          }
        } catch (err) {
          console.error(err);
          resultContainer.style.background = '#fee2e2';
          resultTitle.style.color = '#991b1b';
          resultTitle.innerText = '❌ 通信エラー';
          resultDetails.innerText = 'サーバーとの通信に失敗しました。';
        }

        // 「次のコードを読み取る」ボタンを表示
        restartBtn.style.display = 'inline-block';
      }

      async function restartScanner() {
        document.getElementById('result-container').style.display = 'none';
        document.getElementById('restart-btn').style.display = 'none';
        await startScanner();
      }

      async function startScanner() {
        // すでにインスタンスがあればクリア
        if (!html5QrCode) {
          html5QrCode = new Html5Qrcode("reader");
        }
        
        const config = { fps: 10, qrbox: { width: 250, height: 250 } };
        
        try {
          if (!html5QrCode.isScanning) {
            await html5QrCode.start({ facingMode: "environment" }, config, onScanSuccess);
          }
        } catch (err) {
          console.error("Unable to start scanning.", err);
          alert("カメラを起動できませんでした。カメラの権限が許可されているかご確認ください。");
        }
      }

      // ページ読み込み時にカメラ起動
      window.addEventListener('load', () => {
        startScanner();
      });
    </script>