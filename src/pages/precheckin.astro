---
export const prerender = false;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>宿泊者事前登録</title>
    <style>
      :global(*) {
        box-sizing: border-box;
      }
      :global(body) {
        margin: 0;
        padding: 24px 16px;
        background: #f1f5f9;
        color: #1e293b;
        font-family: sans-serif;
      }
      main {
        max-width: 680px;
        margin: 0 auto;
        padding: 24px;
        background: white;
        border-radius: 12px;
      }
      h1 {
        font-size: 1.5rem;
        margin-top: 0;
      }
      .notice {
        padding: 12px;
        background: #eff6ff;
        border-radius: 8px;
        line-height: 1.7;
      }
      .guest {
        margin-top: 20px;
        padding: 18px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
      }
      .guest h2 {
        font-size: 1.1rem;
        margin-top: 0;
      }
      /* 通常の入力項目は、ラベルと入力欄を縦に配置 */
      label:not(.choice) {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 6px;
        margin-top: 14px;
        font-weight: bold;
      }

      /* チェック欄は横並びのまま維持 */
      label.choice {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        font-weight: normal;
      }

      /* 入力欄の余白 */
      input:not([type="checkbox"]):not([type="radio"]) {
        display: block;
        width: 100%;
        min-width: 0;
        margin-top: 0;
        padding: 11px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        font: inherit;
      }
      input:not([type="checkbox"]):not([type="radio"]) {
        display: block;
        width: 100%;
        margin-top: 6px;
        padding: 11px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        font: inherit;
      }
      .choice {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        font-weight: normal;
      }
      .choice input {
        width: auto;
        margin: 0;
      }
      .hint {
        margin: 6px 0 0;
        color: #475569;
        font-size: 0.9rem;
        line-height: 1.5;
      }
      input:disabled {
        background: #e2e8f0;
        color: #64748b;
      }
      button {
        width: 100%;
        margin-top: 24px;
        padding: 14px;
        border: 0;
        border-radius: 8px;
        background: #1d4ed8;
        color: white;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
      }
      button2 {
        width: 100%;
        margin-top: 24px;
        padding: 14px;
        border: 0;
        border-radius: 8px;
        background: #d8231d;
        color: white;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
      }

      button:disabled {
        opacity: 0.6;
        cursor: wait;
      }
      #message {
        margin-top: 16px;
        line-height: 1.6;
      }
      @media (max-width: 480px) {
        main {
          padding: 18px;
        }
      }

      .form-field {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        width: 100%;
        min-width: 0;
      }

      .form-field label {
        display: block;
        margin-top: 14px;
        font-weight: bold;
      }

      .form-field input:not([type="checkbox"]):not([type="radio"]) {
        display: block;
        width: 100%;
        margin-top: 6px;
      }

      .passport-notice {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 16px;
        padding: 14px 16px;
        border: 1px solid #3b82f6;
        border-radius: 12px;
        background: #eff6ff;
        color: #1e3a8a;
      }

      .passport-notice-icon {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #2563eb;
        color: #fff;
        font-size: 18px;
        font-weight: bold;
      }

      .passport-notice p {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
      }

      @media screen and (max-width: 600px) {
        .passport-notice {
          align-items: flex-start;
          padding: 12px;
        }

        .passport-notice p {
          font-size: 12px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>宿泊者事前登録</h1>
      <p class="notice">
        ご予約の宿泊者全員について、以下の情報をご入力ください。
        予約時に入力された代表者情報は、あらかじめ表示しています。
        内容をご確認のうえ、不足項目を入力してください。
      </p>
      <p id="loading">登録リンクを確認しています…</p>
      <p id="message" role="status" aria-live="polite"></p>
      <form id="precheckin-form" hidden>
        <div id="guest-fields"></div>
        <button type="submit">事前登録を送信</button>
      </form>
      <button2 type="button" id="close-page" hidden>
        終了 (ページを閉じる)
      </button2>
    </main>

    <script is:inline src="/guest-form.js"></script>
    <script>
      const form = document.querySelector("#precheckin-form");
      const fields = document.querySelector("#guest-fields");
      const loading = document.querySelector("#loading");
      const message = document.querySelector("#message");
      const token =
        new URLSearchParams(window.location.search).get("token") || "";

      const labels = [
        ["guest_name", "氏名 name", "text"],
        [
          "gender",
          "性別 gender",
          "select",
          ["男性", "女性", "回答しない/その他"],
        ],
        [
          "age_group",
          "年代 age group",
          "select",
          ["10代以下", "20代", "30代", "40代", "50代", "60代以上"],
        ],
        ["guest_address", "住所 address", "text"],
        ["guest_phone", "電話番号 phone", "tel"],
        ["guest_email", "メールアドレス email", "email"],
        ["nationality", "国籍 nationality", "text"],
        ["passport_number", "パスポート番号 passport number", "text"],
      ];

      async function initialize() {
        try {
          const response = await fetch(
            "/api/precheckin-validate?token=" + encodeURIComponent(token),
            { cache: "no-store" },
          );
          const result = await response.json();

          if (!response.ok || !result.valid) {
            throw new Error(
              result.error || "登録リンクが無効か、有効期限が切れています。",
            );
          }

          for (let i = 0; i < result.guestsCount; i++) {
            const savedGuest = result.savedGuests?.[i];

            // 保存済みの宿泊者情報を優先して表示
            // 保存済み情報がなければ、代表者には予約時の情報を表示
            const values = savedGuest
              ? {
                  guest_name: savedGuest.guest_name,
                  gender: savedGuest.gender,
                  age_group: savedGuest.age_group,
                  guest_address: savedGuest.guest_address,
                  guest_phone: savedGuest.guest_phone,
                  guest_email: savedGuest.guest_email,
                  nationality: savedGuest.nationality,
                  passport_number: savedGuest.passport_number,
                }
              : i === 0
                ? result.primaryGuest
                : null;

            const section = window.GuestForm.createSection({
              index: i,
              guest: values,
              isPrimary: i === 0,
              headingText: i === 0 ? "代表者 (1人目)" : `宿泊者 (${i + 1}人目)`,
              sectionClass: "guest",
              japanResident:
                !!savedGuest &&
                !savedGuest.nationality &&
                !savedGuest.passport_number,
              idStyle: "precheckin",
              requiredFields: true,
              addressLockMode: "readonly",
              getPrimaryAddress: () =>
                fields.querySelector(
                  '.guest:first-child [name="guest_address"]',
                )?.value || "",
            });

            fields.appendChild(section);

            // 代表者の住所変更を、同じ住所に設定した宿泊者へ反映
            if (i === 0) {
              const primaryAddress = section.querySelector(
                '[name="guest_address"]',
              );

              primaryAddress?.addEventListener("input", () => {
                for (const guestSection of fields.querySelectorAll(".guest")) {
                  if (guestSection === section) continue;
                  guestSection.updateGuestFields?.();
                }
              });
            }
          }

          loading.hidden = true;
          form.hidden = false;
        } catch (error) {
          loading.textContent = "";
          message.textContent =
            error instanceof Error
              ? error.message
              : "登録リンクを確認できませんでした。";
        }
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        submitButton.disabled = true;
        message.textContent = "事前登録を送信しています…";

        try {
          const sections = Array.from(fields.querySelectorAll(".guest"));
          const guests = sections.map((section) => {
            const guest = {};

            for (const [name] of labels) {
              const input = section.querySelector(`[name="${name}"]`);
              guest[name] = input.disabled ? "" : input.value.trim();
            }

            guest.japan_resident = section.querySelector(
              '[name="japan_resident"]',
            ).checked;

            return guest;
          });

          const response = await fetch("/api/precheckin-submit", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            cache: "no-store",
            body: JSON.stringify({ token, guests }),
          });

          const result = await response.json();

          if (!response.ok || !result.success) {
            throw new Error(result.error || "登録を保存できませんでした。");
          }

          message.replaceChildren();

          const completed = document.createElement("strong");
          completed.textContent = "宿泊者情報の事前登録が完了しました。";
          message.appendChild(completed);

          const guidance = document.createElement("p");
          guidance.textContent = "予約確定メールの";

          const link = document.createElement("a");
          link.href = window.location.href;
          link.textContent = "宿泊者情報を事前登録する";
          link.style.fontWeight = "bold";

          guidance.appendChild(link);
          guidance.append("から再編集ができます。");
          message.appendChild(guidance);

          document.querySelector("#close-page").hidden = false;
          document
            .querySelector("#close-page")
            ?.addEventListener("click", () => {
              window.close();

              setTimeout(() => {
                if (!window.closed) {
                  alert(
                    "このタブは自動で閉じられません。ブラウザのタブを手動で閉じてください。",
                  );
                }
              }, 300);
            });
          submitButton.disabled = false;
        } catch (error) {
          message.textContent =
            error instanceof Error
              ? error.message
              : "送信に失敗しました。時間をおいて再度お試しください。";
          submitButton.disabled = false;
        }
      });

      initialize();
    </script>
  </body>
</html>
