---
export const prerender = false;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>宿泊者事前登録</title>
    <style>
      :global(*) {
        box-sizing: border-box;
      }
      :global(body) {
        margin: 0;
        padding: 24px 16px;
        background: #f1f5f9;
        color: #1e293b;
        font-family: sans-serif;
      }
      main {
        max-width: 680px;
        margin: 0 auto;
        padding: 24px;
        background: white;
        border-radius: 12px;
      }
      h1 {
        font-size: 1.5rem;
        margin-top: 0;
      }
      .notice {
        padding: 12px;
        background: #eff6ff;
        border-radius: 8px;
        line-height: 1.7;
      }
      .guest {
        margin-top: 20px;
        padding: 18px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
      }
      .guest h2 {
        font-size: 1.1rem;
        margin-top: 0;
      }
      /* 通常の入力項目は、ラベルと入力欄を縦に配置 */
      label:not(.choice) {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 6px;
        margin-top: 14px;
        font-weight: bold;
      }

      /* チェック欄は横並びのまま維持 */
      label.choice {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        font-weight: normal;
      }

      /* 入力欄の余白 */
      input:not([type="checkbox"]):not([type="radio"]) {
        display: block;
        width: 100%;
        min-width: 0;
        margin-top: 0;
        padding: 11px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        font: inherit;
      }
      input:not([type="checkbox"]):not([type="radio"]) {
        display: block;
        width: 100%;
        margin-top: 6px;
        padding: 11px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        font: inherit;
      }
      .choice {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        font-weight: normal;
      }
      .choice input {
        width: auto;
        margin: 0;
      }
      .hint {
        margin: 6px 0 0;
        color: #475569;
        font-size: 0.9rem;
        line-height: 1.5;
      }
      input:disabled {
        background: #e2e8f0;
        color: #64748b;
      }
      button {
        width: 100%;
        margin-top: 24px;
        padding: 14px;
        border: 0;
        border-radius: 8px;
        background: #1d4ed8;
        color: white;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
      }
      button:disabled {
        opacity: 0.6;
        cursor: wait;
      }
      #message {
        margin-top: 16px;
        line-height: 1.6;
      }
      @media (max-width: 480px) {
        main {
          padding: 18px;
        }
      }

      .form-field {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        width: 100%;
        min-width: 0;
      }

      .form-field label {
        display: block;
        margin-top: 14px;
        font-weight: bold;
      }

      .form-field input:not([type="checkbox"]):not([type="radio"]) {
        display: block;
        width: 100%;
        margin-top: 6px;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>宿泊者事前登録</h1>
      <p class="notice">
        ご予約の宿泊者全員について、以下の情報をご入力ください。
        予約時に入力された代表者情報は、あらかじめ表示しています。
        内容をご確認のうえ、不足項目を入力してください。
      </p>

      <p id="loading">登録リンクを確認しています…</p>
      <p id="message" role="status" aria-live="polite"></p>
      <form id="precheckin-form" hidden>
        <div id="guest-fields"></div>
        <button type="submit">事前登録を送信</button>
      </form>
      <button type="button" id="close-page" hidden>
        終了（ページを閉じる）
      </button>
    </main>

    <script>
      const form = document.querySelector("#precheckin-form");
      const fields = document.querySelector("#guest-fields");
      const loading = document.querySelector("#loading");
      const message = document.querySelector("#message");
      const token =
        new URLSearchParams(window.location.search).get("token") || "";

      const labels = [
        ["guest_name", "氏名", "text"],
        ["gender", "性別", "select", ["男性", "女性", "回答しない/その他"]],
        [
          "age_group",
          "年代",
          "select",
          ["10代以下", "20代", "30代", "40代", "50代", "60代以上"],
        ],
        ["guest_address", "住所", "text"],
        ["guest_phone", "電話番号", "tel"],
        ["guest_email", "メールアドレス", "email"],
        ["nationality", "国籍", "text"],
        ["passport_number", "パスポート番号", "text"],
      ];

      function updateGuestFields(section, isPrimary) {
        const japanResident = section.querySelector('[name="japan_resident"]');
        const address = section.querySelector('[name="guest_address"]');
        const nationality = section.querySelector('[name="nationality"]');
        const passport = section.querySelector('[name="passport_number"]');
        const sameAddress = section.querySelector('[name="same_address"]');

        nationality.disabled = japanResident.checked;
        passport.disabled = japanResident.checked;
        nationality.required = !japanResident.checked;
        passport.required = !japanResident.checked;

        if (japanResident.checked) {
          nationality.value = "";
          passport.value = "";
        }

        if (!isPrimary && sameAddress.checked) {
          const primaryAddress = fields.querySelector(
            '.guest:first-child [name="guest_address"]',
          );
          address.value = primaryAddress ? primaryAddress.value : "";
          address.readOnly = true;
        } else {
          address.readOnly = false;
        }
      }

      async function initialize() {
        try {
          const response = await fetch(
            "/api/precheckin-validate?token=" + encodeURIComponent(token),
            { cache: "no-store" },
          );
          const result = await response.json();

          if (!response.ok || !result.valid) {
            throw new Error(
              result.error || "登録リンクが無効か、有効期限が切れています。",
            );
          }

          for (let i = 0; i < result.guestsCount; i++) {
            const section = document.createElement("section");
            const savedGuest = result.savedGuests?.[i];
            section.className = "guest";

            const heading = document.createElement("h2");
            heading.textContent =
              i === 0 ? "代表者（1人目）" : "宿泊者 " + (i + 1) + "人目";
            section.appendChild(heading);

            if (i > 0) {
              const sameAddressLabel = document.createElement("label");
              sameAddressLabel.className = "choice";

              const sameAddress = document.createElement("input");
              sameAddress.type = "checkbox";
              sameAddress.name = "same_address";

              sameAddressLabel.appendChild(sameAddress);
              sameAddressLabel.append("代表者と同じ住所にする");
              section.appendChild(sameAddressLabel);

              sameAddress.addEventListener("change", () => {
                updateGuestFields(section, false);
              });
            }
            for (const [name, labelText, type, options] of labels) {
              const field = document.createElement("div");
              field.className = "form-field";

              const label = document.createElement("label");
              label.textContent = labelText;

              const input =
                type === "select"
                  ? document.createElement("select")
                  : document.createElement("input");

              input.name = name;
              input.required = !["nationality", "passport_number"].includes(
                name,
              );

              if (type === "select") {
                const placeholder = document.createElement("option");
                placeholder.value = "";
                placeholder.textContent = "選択してください";
                input.appendChild(placeholder);

                for (const optionText of options || []) {
                  const option = document.createElement("option");
                  option.value = optionText;
                  option.textContent = optionText;
                  input.appendChild(option);
                }
              } else {
                input.type = type;
                input.maxLength = name === "guest_address" ? 500 : 200;
                input.autocomplete = "off";
              }
              // 予約時に入力された代表者情報を初期表示
              // 保存済みの宿泊者情報を優先して表示
              const savedGuest = result.savedGuests?.[i];

              const values = savedGuest
                ? {
                    guest_name: savedGuest.guest_name,
                    gender: savedGuest.gender,
                    age_group: savedGuest.age_group,
                    guest_address: savedGuest.guest_address,
                    guest_phone: savedGuest.guest_phone,
                    guest_email: savedGuest.guest_email,
                    nationality: savedGuest.nationality,
                    passport_number: savedGuest.passport_number,
                  }
                : i === 0
                  ? result.primaryGuest
                  : null;

              const value = values?.[name];

              if (value && (type !== "select" || options.includes(value))) {
                input.value = value;
              }
              if (name === "guest_address" && i > 0) {
                input.addEventListener("input", () => {
                  const sameAddress = section.querySelector(
                    '[name="same_address"]',
                  );
                  if (sameAddress?.checked) sameAddress.checked = false;
                });
              }

              label.htmlFor = name + "_" + i;
              input.id = name + "_" + i;

              field.appendChild(label);
              field.appendChild(input);
              section.appendChild(field);

              if (name === "guest_address" && i === 0) {
                input.addEventListener("input", () => {
                  for (const guestSection of fields.querySelectorAll(
                    ".guest",
                  )) {
                    if (guestSection === section) continue;
                    const sameAddress = guestSection.querySelector(
                      '[name="same_address"]',
                    );
                    if (sameAddress?.checked) {
                      updateGuestFields(guestSection, false);
                    }
                  }
                });
              }

              if (name === "nationality") {
                const residenceLabel = document.createElement("label");
                residenceLabel.className = "choice";

                const residence = document.createElement("input");
                residence.type = "checkbox";
                residence.name = "japan_resident";
                residence.checked =
                  !!savedGuest &&
                  !savedGuest.nationality &&
                  !savedGuest.passport_number;

                residenceLabel.appendChild(residence);
                residenceLabel.append("日本国内に住所がある");
                section.insertBefore(residenceLabel, field);

                const hint = document.createElement("p");
                hint.className = "hint";
                hint.textContent =
                  "日本国内に住所がある場合はチェックしてください。国籍・パスポート欄は空欄になります。";
                section.insertBefore(hint, field);

                residence.addEventListener("change", () => {
                  updateGuestFields(section, i === 0);
                });
              }
            }

            fields.appendChild(section);
            updateGuestFields(section, i === 0);
          }

          loading.hidden = true;
          form.hidden = false;
        } catch (error) {
          loading.textContent = "";
          message.textContent =
            error instanceof Error
              ? error.message
              : "登録リンクを確認できませんでした。";
        }
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        submitButton.disabled = true;
        message.textContent = "事前登録を送信しています…";

        try {
          const sections = Array.from(fields.querySelectorAll(".guest"));
          const guests = sections.map((section) => {
            const guest = {};

            for (const [name] of labels) {
              const input = section.querySelector(`[name="${name}"]`);
              guest[name] = input.disabled ? "" : input.value.trim();
            }

            guest.japan_resident = section.querySelector(
              '[name="japan_resident"]',
            ).checked;

            return guest;
          });

          const response = await fetch("/api/precheckin-submit", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            cache: "no-store",
            body: JSON.stringify({ token, guests }),
          });

          const result = await response.json();

          if (!response.ok || !result.success) {
            throw new Error(result.error || "登録を保存できませんでした。");
          }

          message.replaceChildren();

          const completed = document.createElement("strong");
          completed.textContent = "宿泊者情報の事前登録が完了しました。";
          message.appendChild(completed);

          const guidance = document.createElement("p");
          guidance.textContent = "予約確定メールの";

          const link = document.createElement("a");
          link.href = window.location.href;
          link.textContent = "宿泊者情報を事前登録する";
          link.style.fontWeight = "bold";

          guidance.appendChild(link);
          guidance.append("から再編集ができます。");
          message.appendChild(guidance);

          document.querySelector("#close-page").hidden = false;
          document
            .querySelector("#close-page")
            ?.addEventListener("click", () => {
              window.close();

              setTimeout(() => {
                if (!window.closed) {
                  alert(
                    "このタブは自動で閉じられません。ブラウザのタブを手動で閉じてください。",
                  );
                }
              }, 300);
            });
          submitButton.disabled = false;
        } catch (error) {
          message.textContent =
            error instanceof Error
              ? error.message
              : "送信に失敗しました。時間をおいて再度お試しください。";
          submitButton.disabled = false;
        }
      });

      initialize();
    </script>
  </body>
</html>
