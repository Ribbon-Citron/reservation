---
const pageTitle = "宿泊施設のご案内 | CENTER INN";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="CENTER INNの宿泊施設情報、ご予約方法、お問い合わせ先をご案内します。"
    />
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="brand">CENTER <span>INN</span></a>
      <a href="/" class="back-link">予約ページへ</a>
    </header>

    <!-- 設備アイコン SVG 定義 -->
    <svg xmlns="http://www.w3.org/2000/svg" style="display:none;">
      <symbol id="icon-shampoo" viewBox="0 0 24 24">
        <path d="M9 3h6M10 3v3h4V3M8 7h8v14H8z"></path>
        <path d="M10 11h4M10 15h4"></path>
      </symbol>

      <symbol id="icon-soap" viewBox="0 0 24 24">
        <path d="M9 4h6M10 4V2h4v2M8 7h8v14H8z"></path>
        <path d="M10 11h4M10 15h4"></path>
      </symbol>

      <symbol id="icon-wifi" viewBox="0 0 24 24">
        <path
          d="M2 8.5a15 15 0 0 1 20 0M5 12a10 10 0 0 1 14 0M8.5 15.5a5 5 0 0 1 7 0"
        ></path>
        <circle cx="12" cy="19" r="1"></circle>
      </symbol>

      <symbol id="icon-smoking" viewBox="0 0 24 24">
        <path d="M3 15h14v4H3zM19 15v4M21 15v4M5 12l2-2M10 12l2-2"></path>
        <path d="M3 3l18 18"></path>
      </symbol>

      <symbol id="icon-towel" viewBox="0 0 24 24">
        <path d="M4 5h16v14H4zM7 8h10M7 11h10M7 14h6"></path>
        <path d="M4 5l3-2h13v14l-3 2"></path>
      </symbol>

      <!-- <symbol id="icon-toothbrush" viewBox="0 0 24 24">
        <path d="M4 18l13-13 3 3L7 21z"></path>
        <path d="M14 8l3 3M16 6l2-2M18 8l2-2M20 10l2-2"></path>
      </symbol> -->
      
<symbol id="icon-toothbrush" viewBox="0 0 24 24">
  <g
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M8 9.5 L15 16.5 Q16 17.5 17 16.5 L19 14.5 Q20 13.5 19 12.5 L12 5.5"/>
    <path d="M8 9.5 L5 6.5 Q4 5.5 5 4.5 L6.5 3 Q7.5 2 8.5 3 L12 6.5"/>
    <path d="M5 4.5 L3.5 3 M6.5 3 L5.5 1.5 M8.5 3 L8 1.5 M10 4.5 L11 3"/>
  </g>
</symbol>


      <symbol id="icon-dryer" viewBox="0 0 24 24">
        <path d="M4 7h12a3 3 0 0 1 0 6H4z"></path>
        <path d="M16 13l3 7h-4l-3-7M7 9h5M7 11h5"></path>
      </symbol>

      <symbol id="icon-kitchen" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <circle cx="8" cy="8" r="2"></circle>
        <circle cx="16" cy="8" r="2"></circle>
        <path d="M6 14h12v4H6z"></path>
      </symbol>

      <symbol id="icon-bath" viewBox="0 0 24 24">
        <path d="M3 12h18v4a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"></path>
        <path d="M5 12V6a3 3 0 0 1 6 0M7 20v2M17 20v2"></path>
      </symbol>

      <symbol id="icon-laundry" viewBox="0 0 24 24">
        <rect x="3" y="2" width="18" height="20" rx="2"></rect>
        <path d="M3 7h18"></path>
        <circle cx="12" cy="14" r="5"></circle>
        <path d="M9 14c1-2 4-2 6 0"></path>
        <circle cx="7" cy="4.5" r=".5"></circle>
      </symbol>

      <symbol id="icon-tv" viewBox="0 0 24 24">
        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
        <path d="M8 22h8M12 19v3M8 2l4 3 4-3"></path>
      </symbol>

      <symbol id="icon-parking" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M10 18V6h4a4 4 0 0 1 0 8h-4"></path>
      </symbol>

      <symbol id="icon-invoice" viewBox="0 0 24 24">
        <path d="M5 2h14v20l-3-2-4 2-4-2-3 2z"></path>
        <path d="M8 7h8M8 11h8M8 15h5"></path>
      </symbol>

      <symbol id="icon-bathroom" viewBox="0 0 24 24">
        <path d="M15 2h-1c-4.41 0-8 3.59-8 8v10h2V10c0-3.31 2.69-6 6-6h1V5z"
        ></path>
        <path d="M14 5h5v3h-5z"></path>
        <circle cx="15.2" cy="11.5" r="0.2"></circle>
        <circle cx="18.5" cy="11.5" r="0.2"></circle>
        <circle cx="14.5" cy="14.5" r="0.2"></circle>
        <circle cx="17.5" cy="14.5" r="0.2"></circle>
        <circle cx="20.5" cy="14.5" r="0.2"></circle>
      </symbol>

      <symbol id="icon-livingroom" viewBox="0 0 24 24">
        <path d="M4 11h16a2 2 0 0 1 2 2v5H2v-5a2 2 0 0 1 2-2Z"></path>
        <path d="M4 11V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3"></path>
        <path d="M4 18v2M20 18v2"></path>
        <path d="M8 11v7M16 11v7"></path>
      </symbol>
    </svg>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <p class="eyebrow">INFORMATION</p>
          <h1>宿泊施設のご案内</h1>
          <!-- <p>施設の情報やご予約方法についてご案内します。</p> -->
        </div>
      </section>

      <div class="container">
        <div class="draft-warning">
          <strong>⚠ これは仮情報です</strong>
          <p>
            施設情報・写真・案内内容は準備中です。
            正式な情報が決まり次第差し替えます。
          </p>
        </div>

        <!-- 施設情報 -->
        <section class="content-section">
          <div class="section-heading">
            <p class="eyebrow">01 / FACILITY</p>
            <h2>設備・施設のご案内</h2>
          </div>

          <div class="facility-card">
            <div class="room-gallery">
              <button
                class="gallery-button gallery-prev"
                type="button"
                aria-label="前の写真">‹</button
              >

              <img
                id="room-image"
                src="/room1.jpg"
                alt="お部屋の写真 1 / 5"
                class="facility-image"
              />

              <button
                class="gallery-button gallery-next"
                type="button"
                aria-label="次の写真">›</button
              >

              <div class="gallery-dots" aria-label="写真の位置">
                {
                  Array.from({ length: 5 }, (_, i) => (
                    <button
                      type="button"
                      class:list={["gallery-dot", { active: i === 0 }]}
                      data-index={i}
                      aria-label={`写真 ${i + 1}`}
                      aria-current={i === 0 ? "true" : undefined}
                    />
                  ))
                }
              </div>
            </div>
          </div>
          <div class="amenity-icons" aria-label="設備・アメニティ">
            <div class="amenity-item available">
              <svg class="amenity-icon" role="img" aria-label="シャンプー"
                ><use href="#icon-shampoo"></use></svg
              >
              <span>Shampoo</span>
            </div>

            <div class="amenity-item available">
              <svg class="amenity-icon" role="img" aria-label="ボディソープ"
                ><use href="#icon-soap"></use></svg
              >
              <span>Body Soap</span>
            </div>

            <div class="amenity-item unavailable">
              <svg class="amenity-icon" role="img" aria-label="タオル"
                ><use href="#icon-towel"></use></svg
              >
              <span>× Towel</span>
            </div>

            <div class="amenity-item unavailable">
              <svg class="amenity-icon" role="img" aria-label="歯ブラシ"
                ><use href="#icon-toothbrush"></use></svg
              >
              <span>× Toothbrush</span>
            </div>

            <div class="amenity-item unavailable">
              <svg class="amenity-icon" role="img" aria-label="ドライヤー"
                ><use href="#icon-dryer"></use></svg
              >
              <span>× Hair Dryer</span>
            </div>

            <div class="amenity-item available">
              <svg class="amenity-icon" role="img" aria-label="バスルーム"
                ><use href="#icon-bathroom"></use></svg
              >
              <span>Share Bathroom</span>
            </div>

            <div class="amenity-item unavailable">
              <svg class="amenity-icon" role="img" aria-label="浴槽"
                ><use href="#icon-bath"></use></svg
              >
              <span>× Bathtub</span>
            </div>

            <div class="amenity-item available">
              <svg class="amenity-icon" role="img" aria-label="リビング"
                ><use href="#icon-livingroom"></use></svg
              >
              <span>Share Living</span>
            </div>

            <div class="amenity-item unavailable">
              <svg class="amenity-icon" role="img" aria-label="キッチン"
                ><use href="#icon-kitchen"></use></svg
              >
              <span>× Kitchen</span>
            </div>

            <div class="amenity-item unavailable">
              <svg class="amenity-icon" role="img" aria-label="洗濯機"
                ><use href="#icon-laundry"></use></svg
              >
              <span>× Laundry</span>
            </div>

            <div class="amenity-item unavailable">
              <svg class="amenity-icon" role="img" aria-label="テレビ"
                ><use href="#icon-tv"></use></svg
              >
              <span>× TV</span>
            </div>

            <div class="amenity-item available">
              <svg class="amenity-icon" role="img" aria-label="Wi-Fi"
                ><use href="#icon-wifi"></use></svg
              >
              <span>Wi-Fi</span>
            </div>

            <div class="amenity-item unavailable">
              <svg class="amenity-icon" role="img" aria-label="駐車場"
                ><use href="#icon-parking"></use></svg
              >
              <span>× Parking</span>
            </div>

            <div class="amenity-item unavailable">
              <svg class="amenity-icon" role="img" aria-label="インボイス対応"
                ><use href="#icon-invoice"></use></svg
              >
              <span>× Invoice</span>
            </div>

            <div class="amenity-item available">
              <svg class="amenity-icon" role="img" aria-label="禁煙"
                ><use href="#icon-smoking"></use></svg
              >
              <span>Non-smoking</span>
            </div>
          </div>
          <div style="font-size: 0.85em; color: #333; text-align: center;">
            CHECK-IN TIME 4:00 PM / CHECK-OUT TIME 10:00 AM
          </div>
        </section>

        <section class="content-section booking-section">
          <div class="section-heading">
            <p class="eyebrow">02 / RESERVATION</p>
            <h2>リクエスト予約制について</h2>
          </div>

          <div class="info-panel">
            <p>CENTER INNでは、リクエスト予約制を採用しています。</p>
            <ol>
              <li>予約ページから希望の日程・人数などを入力して送信します。</li>
              <li>施設側で予約内容と空室状況を確認します。</li>
              <li>施設からの承認・確定の連絡をもって予約成立となります。</li>
            </ol>
            <p class="note">
              予約リクエストを送信した時点では予約は確定していません。
            </p>
            <a href="/" class="primary-button">予約ページへ</a>
          </div>
        </section>

        <section id="contact" class="content-section contact-section">
          <div class="section-heading">
            <p class="eyebrow">03 / CONTACT</p>
            <h2>お問い合わせ</h2>
          </div>

          <form id="contact-form" class="contact-form">
            <div class="form-group">
              <label for="contact-name">お名前 <span>必須</span></label>
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="お名前を入力してください"
                maxlength="100"
                required
                autocomplete="name"
              />
            </div>

            <div class="form-group">
              <label for="contact-email">メールアドレス <span>必須</span></label
              >
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="メールアドレスを入力してください"
                maxlength="254"
                required
                autocomplete="email"
              />
            </div>

            <div class="form-group">
              <label for="contact-message">メッセージ <span>必須</span></label>
              <textarea
                id="contact-message"
                name="message"
                rows="7"
                placeholder="お問い合わせ内容を入力してください"
                maxlength="5000"
                required></textarea>
            </div>

            <!-- 迷惑送信対策用の隠し項目 -->
            <div class="honeypot" aria-hidden="true">
              <label for="contact-website">ウェブサイト</label>
              <input
                type="text"
                id="contact-website"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <button type="submit" id="contact-submit" class="primary-button">
              送信する
            </button>

            <p
              id="contact-status"
              class="contact-status"
              role="status"
              aria-live="polite"
            >
            </p>
          </form>
        </section>

        <section class="terms-link-section">
          <p class="eyebrow">04 / CONTACT</p>
          <a href="/terms" class="terms-link">
            利用規約・宿泊約款（特商法に基づく表示）
            <span>→</span>
          </a>
        </section>
      </div>

      <footer class="site-footer">
        <p>© CENTER INN</p>
      </footer>

      <script>
        const contactForm =
          document.querySelector<HTMLFormElement>("#contact-form");
        const contactSubmit =
          document.querySelector<HTMLButtonElement>("#contact-submit");
        const contactStatus =
          document.querySelector<HTMLParagraphElement>("#contact-status");

        contactForm?.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (!contactForm.reportValidity()) return;

          if (!contactSubmit || !contactStatus) return;

          contactSubmit.disabled = true;
          contactSubmit.textContent = "送信中...";
          contactStatus.textContent = "";
          contactStatus.className = "contact-status";

          const formData = new FormData(contactForm);

          const payload = {
            name: String(formData.get("name") || ""),
            email: String(formData.get("email") || ""),
            message: String(formData.get("message") || ""),
            website: String(formData.get("website") || ""),
          };

          try {
            const response = await fetch("/api/contact", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(payload),
            });

            const result = await response.json();

            if (!response.ok) {
              throw new Error(result.error || "送信に失敗しました。");
            }

            contactStatus.textContent =
              "お問い合わせを送信しました。ありがとうございます。";
            contactStatus.classList.add("success");
            contactForm.reset();
          } catch (error) {
            contactStatus.textContent =
              error instanceof Error
                ? error.message
                : "送信に失敗しました。時間をおいて再度お試しください。";
            contactStatus.classList.add("error");
          } finally {
            contactSubmit.disabled = false;
            contactSubmit.textContent = "送信する";
          }
        });

        const roomPhotos = [
          "/room1.jpg",
          "/room2.jpg",
          "/room3.jpg",
          "/room4.jpg",
          "/room5.jpg",
        ];

        const roomImage = document.querySelector("#room-image");
        const prevButton = document.querySelector(".gallery-prev");
        const nextButton = document.querySelector(".gallery-next");
        const dots = document.querySelectorAll(".gallery-dot");

        let currentIndex = 0;

        function showRoomPhoto(index) {
          currentIndex = (index + roomPhotos.length) % roomPhotos.length;

          roomImage.src = roomPhotos[currentIndex];
          roomImage.alt = `お部屋の写真 ${currentIndex + 1} / ${roomPhotos.length}`;

          dots.forEach((dot, i) => {
            dot.classList.toggle("active", i === currentIndex);

            if (i === currentIndex) {
              dot.setAttribute("aria-current", "true");
            } else {
              dot.removeAttribute("aria-current");
            }
          });
        }

        prevButton?.addEventListener("click", () => {
          showRoomPhoto(currentIndex - 1);
        });

        nextButton?.addEventListener("click", () => {
          showRoomPhoto(currentIndex + 1);
        });

        dots.forEach((dot) => {
          dot.addEventListener("click", () => {
            showRoomPhoto(Number(dot.dataset.index));
          });
        });
      </script>

      <style>
        :root {
          --navy: #1e293b;
          --red: #a3080f;
          --background: #f8fafc;
          --text: #0f172a;
          --muted: #64748b;
          --border: #e2e8f0;
        }

        * {
          box-sizing: border-box;
        }

        body {
          margin: 0;
          background: var(--background);
          color: var(--text);
          font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
          line-height: 1.8;
        }

        a {
          color: inherit;
          text-decoration: none;
        }

        .site-header {
          height: 68px;
          padding: 0 6%;
          display: flex;
          align-items: center;
          justify-content: space-between;
          background: white;
          border-bottom: 1px solid var(--border);
        }

        .brand {
          font-size: 21px;
          font-weight: 900;
          letter-spacing: 1px;
          text-decoration: none;
        }

        .brand span {
          color: #ef4444;
        }

        .hero {
          background: var(--navy);
          color: white;
          padding: 20px 20px;
          text-align: center;
        }

        .hero-inner {
          max-width: 900px;
          margin: auto;
        }

        .hero h1 {
          margin: 0px 0;
          font-size: clamp(0.8rem, 5vw, 3rem);
          letter-spacing: 0.04em;
        }

        .hero p:last-child {
          margin: 8px 0 0;
          color: #cbd5e1;
        }

        .eyebrow {
          margin: 0;
          color: var(--red);
          font-size: 0.75rem;
          font-weight: 800;
          letter-spacing: 0.16em;
        }

        .hero .eyebrow {
          color: #fca5a5;
        }

        .container {
          width: min(900px, 90%);
          margin: 45px auto 80px;
        }

        .draft-warning {
          padding: 18px 22px;
          margin-bottom: 65px;
          background: #fff7ed;
          border: 1px solid #fdba74;
          border-left: 5px solid var(--red);
          border-radius: 8px;
        }

        .draft-warning strong {
          color: var(--red);
        }

        .draft-warning p {
          margin: 5px 0 0;
          font-size: 0.9rem;
        }

        .content-section {
          margin-bottom: 60px;
        }

        .section-heading {
          margin-bottom: 8px;
        }

        .section-heading h2 {
          margin: 0px 0;
          color: var(--navy);
          font-size: clamp(0.8rem, 5vw, 1rem);
        }

        .facility-card {
          overflow: hidden;
          background: white;
          /* border: 1px solid var(--border); */
          border-radius: 12px;
          /* box-shadow: 0 1px 1px rgb(15 23 42 / 4%); */
        }

        .room-gallery {
          position: relative;
          width: 100%;
          background: #eee;
        }

        .facility-image {
          display: block;
          width: 100%;
          aspect-ratio: 16 / 9;
          object-fit: cover;
        }

        .gallery-button {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          z-index: 2;
          width: 42px;
          height: 52px;
          border: none;
          border-radius: 6px;
          background: rgb(0 0 0 / 45%);
          color: white;
          font-size: 55px;
          line-height: 1;
          cursor: pointer;
        }

        .gallery-prev {
          left: 12px;
        }

        .gallery-next {
          right: 12px;
        }

        .gallery-button:hover {
          background: rgb(0 0 0 / 70%);
        }

        .gallery-dots {
          position: absolute;
          bottom: 10px;
          left: 50%;
          transform: translateX(-50%);
          z-index: 3;

          display: flex;
          justify-content: center;
          align-items: center;
          gap: 8px;

          padding: 6px 10px;
          background: rgb(0 0 0 / 30%);
          border-radius: 20px;
        }

        .gallery-dot {
          width: 7px;
          height: 7px;
          padding: 0;
          border: none;
          border-radius: 50%;
          background: rgb(255 255 255 / 65%);
          cursor: pointer;
        }

        .gallery-dot.active {
          background: white;
          transform: scale(1.25);
        }

        .amenity-icons {
          display: grid;
          grid-template-columns: repeat(5, 60px);
          justify-content: center;
          gap: 14px 12px;
          padding: 20px 12px;
        }

        .amenity-item {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 3px;
          min-width: 0;
        }

        .amenity-icon {
          width: 20px;
          height: 20px;
          fill: none;
          stroke: #333;
          stroke-width: 1.8;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .amenity-item span {
          font-size: 10px;
          line-height: 1.3;
          color: #333;
          text-align: center;
          white-space: nowrap;
        }

        .amenity-item.available {
          opacity: 1;
        }

        .amenity-item.unavailable {
          opacity: 0.35;
        }

        .facility-text {
          padding: 24px 28px;
        }

        .facility-text h3 {
          margin: 0 0 8px;
          color: var(--navy);
        }

        .facility-text p {
          margin: 0;
          color: var(--muted);
        }

        .info-panel,
        .contact-form {
          font-size: 0.8rem;
          padding: 10px;
          background: #ffffff;
          border: 1px solid var(--border);
          border-radius: 12px;
          box-shadow: 0 5px 20px rgb(15 23 42 / 4%);
        }

        .info-panel ol {
          padding-left: 1.5em;
          margin: 0px 0;
        }

        .info-panel li {
          padding: 0px 0;
        }

        .note {
          padding: 12px 16px;
          background: #fff7ed;
          border-radius: 6px;
          color: #9a3412;
          font-size: 0.8rem;
        }

        .back-link,
        .primary-button {
          font-size: 0.8rem;
          text-decoration: none;
          border: 1px solid #94a3b8;
          border-radius: 7px;
          padding: 6px 12px;
          background: white;
          color: var(--navy);
